---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/og.jpg', Astro.site).href;
const { title, description = 'Julia Kryshyna — Product Designer in Warsaw. Fintech, crypto and travel products from zero to launch.', current = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eeeeee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
  </head>
  <body id="top">
    <Header current={current} />
    <main>
      <slot />
    </main>
    <Contact />
    <Footer />
  </body>
</html>

---
import Base from '../../layouts/Base.astro';
import { nb } from '../../lib/nb.js';
import NextCase from '../../components/NextCase.astro';

const img = (n) => `/images/bd/${n}.webp`;
const meta = [
  ['Role', 'Lead Product Designer'],
  ['Timeline', 'Mar 2024 – Aug 2025'],
  ['Team', '2 designers I led, 6 engineers and the CEO'],
  ['Scope', 'Responsive web, design system, team and process']
];
const stats = [
  ['6 mo', 'from zero to launch'],
  ['60+', 'responsive screens, desktop to mobile'],
  ['80+', 'components in the design system'],
  ['Hours', 'to design a new page, down from days']
];
const nav = [
  ['overview', 'Overview'],
  ['problem', 'The problem'],
  ['role', 'My role'],
  ['process', 'Process'],
  ['decisions', 'Key decisions'],
  ['screens', 'Screens'],
  ['outcome', 'Outcome & learnings']
];
const steps = [
  ['01', 'Research', 'Competitors and the market, then the gaps.'],
  ['02', 'MVP scope', 'Cut the plan to what fits 6 months.'],
  ['03', 'Design system', 'Built in parallel with the screens.'],
  ['04', 'Handoff & QA', 'Specs, then QA of every build.']
];
const decisions = [
  {
    n: '01', title: 'A smaller MVP that could ship',
    problem: 'The first plan had too many features for 6 months, and a late launch would cost more than missing features.',
    solution: 'Based on market research, I proposed a smaller scope that still covered the full booking flow: search, property page, checkout and confirmation. Everything else moved to later releases.',
    image: 'decision-1', alt: 'Core flow: home, property page, checkout and confirmation'
  },
  {
    n: '02', title: 'Design system from day one',
    problem: 'Three designers and six engineers had to move fast, and every new page risked looking a little different.',
    solution: 'I built the design system in parallel with the first screens, not after them. Everyone worked from one source, and a new page took hours instead of days.',
    image: 'decision-2', alt: 'Components of the design system and a hotel card'
  },
  {
    n: '03', title: 'Honest labels for cheaper, less reliable stays',
    problem: 'Some properties were cheaper but less reliable. Hiding them meant fewer options, and showing them as equal could break trust.',
    solution: 'A clear label that says the place is OK but not top-rated, and that this is why it costs less. It took three versions to find the right balance between trust and price.',
    image: 'decision-3', alt: 'Partner offer label: three versions from a quiet label to a clear disclosure'
  }
];
---
<Base title="BookDirect.com — Julia Kryshyna" description="Case study: a direct booking platform for hotels, from zero to launch in 6 months. Team, design system and key flows." current="work">
  <section class="hero">
    <div class="container hero__inner">
      <a class="back muted" href="/#work">← All work</a>
      <div class="hero__title">
        <div class="tags"><span class="tag">Web platform</span><span class="tag">Travel</span><span class="tag">0 → 1</span><span class="tag">Live product</span></div>
        <h1 class="h1-case">{nb('Built a direct booking platform from zero to launch in 6 months')}</h1>
        <p class="lead">{nb('BookDirect.com lets travelers book hotels directly, so properties pay lower fees than on big platforms. I led design from the first wireframe to launch: the team, the design system and the key flows.')}</p>
        <a class="label live" href="https://www.bookdirect.com" target="_blank" rel="noopener">Live at bookdirect.com ↗</a>
      </div>
      <figure class="stack-16">
        <div class="panel"><img src={img('cover')} alt="BookDirect.com home page with hotel search" width="1312" height="720" /></div>
        <figcaption class="muted caption">{nb('Screens shown in a 2026 visual refresh. The flow and the decisions are from the shipped product.')}</figcaption>
      </figure>
    </div>
  </section>

  <section class="meta-wrap">
    <div class="container meta">
      {meta.map(([k, v]) => (
        <div class="meta__item"><span class="label">{k}</span><span class="meta__value">{nb(v)}</span></div>
      ))}
    </div>
  </section>

  <section class="impact">
    <div class="container impact__grid">
      {stats.map(([v, l]) => (
        <div class="stat"><span class="stat__value">{v}</span><span class="muted">{nb(l)}</span></div>
      ))}
    </div>
  </section>

  <section class="body-wrap">
    <div class="container case">
      <nav class="case__nav" aria-label="On this page">
        <p class="label">On this page</p>
        {nav.map(([id, t]) => <a href={`#${id}`} data-nav={id}>{t}</a>)}
      </nav>

      <div class="case__content">
        <section id="overview" class="block">
          <h2 class="h3">Overview</h2>
          <p class="body">{nb('Big booking platforms take high fees from hotels. The founder had direct contacts with many properties and wanted a platform where travelers book directly and properties keep more of their money. The first version had to launch fast and still feel safe to book with.')}</p>
        </section>

        <section id="problem" class="block">
          <h2 class="h3">The problem</h2>
          <p class="body">{nb('We had to build the whole product from zero in 6 months: no design team, no design system, no process. And a new brand had to feel as safe as the big ones, or nobody would leave their card details.')}</p>
        </section>

        <section id="role" class="block">
          <h2 class="h3">My role</h2>
          <div class="text">
            <p class="body">{nb('I was the lead designer and worked directly with the CEO. There was no PM, so I also helped shape the scope.')}</p>
            <ul class="bullets body">
              <li>{nb('I hired 2 designers and led the design team: design reviews, file structure, and a check of every design before handoff')}</li>
              <li>{nb('I built the design system myself and designed the key flows hands-on')}</li>
              <li>{nb('I wrote specs for developers and did design QA after each feature')}</li>
            </ul>
          </div>
        </section>

        <section id="process" class="block">
          <h2 class="h3">Process</h2>
          <div class="stack-40">
            <div class="steps">
              {steps.map(([n, h, d]) => (
                <div class="step"><span class="label">{n}</span><h3 class="step__title">{h}</h3><p class="muted">{nb(d)}</p></div>
              ))}
            </div>
            <figure class="stack-16">
              <div class="panel"><img src={img('process')} alt="Home page: wireframe and final design side by side" loading="lazy" /></div>
              <figcaption class="muted caption">{nb('Every page started as a wireframe I agreed with the CEO, then moved to the final UI.')}</figcaption>
            </figure>
          </div>
        </section>

        <section id="decisions" class="block">
          <h2 class="h3">Key decisions</h2>
          <div class="decisions">
            {decisions.map((d) => (
              <article class="decision">
                <div class="decision__text">
                  <div class="decision__heading">
                    <p class="label label--accent">Decision {d.n}</p>
                    <h3 class="h4">{nb(d.title)}</h3>
                  </div>
                  <div class="text body">
                    <p><span class="muted">The problem:</span> {nb(d.problem)}</p>
                    <p><span class="muted">My solution:</span> {nb(d.solution)}</p>
                  </div>
                </div>
                <div class="panel"><img src={img(d.image)} alt={d.alt} loading="lazy" /></div>
              </article>
            ))}
          </div>
        </section>

        <section id="screens" class="block">
          <h2 class="h3">Screens</h2>
          <figure class="stack-16">
            <div class="gallery">
              <div class="gallery__row gallery__row--2">
                <div class="panel"><img src={img('gallery-1')} alt="Home on mobile" loading="lazy" /></div>
                <div class="panel"><img src={img('gallery-2')} alt="Property page on mobile" loading="lazy" /></div>
              </div>
              <div class="panel"><img src={img('gallery-3')} alt="Property page on desktop" loading="lazy" /></div>
              <div class="gallery__row gallery__row--3">
                <div class="panel"><img src={img('gallery-4')} alt="Checkout on mobile" loading="lazy" /></div>
                <div class="panel"><img src={img('gallery-5')} alt="Booking confirmation on mobile" loading="lazy" /></div>
                <div class="panel"><img src={img('gallery-6')} alt="Sign in on mobile" loading="lazy" /></div>
              </div>
            </div>
            <figcaption class="muted caption">Home and property on mobile · Property page on desktop · Checkout, confirmation, sign in</figcaption>
          </figure>
        </section>

        <section id="outcome" class="block">
          <h2 class="h3">Outcome & learnings</h2>
          <div class="stack-40">
            <ul class="bullets body">
              <li>{nb('The product launched in 6 months and is live at bookdirect.com')}</li>
              <li>{nb('The design system has 80+ components and is used by the design team and 6 engineers. A new page takes hours, not days')}</li>
              <li>{nb('The design team and process were built from zero: hiring, reviews, file structure, specs and design QA')}</li>
            </ul>
            <div class="stack-12">
              <h3 class="sub">What I learned</h3>
              <p class="body">{nb('Building from zero taught me to say no early. A smaller MVP that ships is worth more than a big plan that doesn’t. Working directly with the CEO also taught me to turn business ideas into clear product decisions fast.')}</p>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
  <NextCase href="/work/papaya/" title="AI food ordering assistant" image="/images/pp/next.webp" alt="Papaya app screens" />
</Base>

<script>
  const links = [...document.querySelectorAll('[data-nav]')];
  const map = new Map(links.map((a) => [a.dataset.nav, a]));
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        links.forEach((l) => l.classList.remove('is-active'));
        map.get(e.target.id)?.classList.add('is-active');
      }
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  map.forEach((_, id) => { const s = document.getElementById(id); if (s) obs.observe(s); });
</script>

<style>
  .hero { padding: 64px 0 64px; }
  .hero__inner { display: flex; flex-direction: column; gap: 48px; }
  .back { font-size: 15px; font-weight: 500; width: fit-content; }
  .back:hover { color: var(--accent); }
  .live { width: fit-content; color: var(--accent); }
  .live:hover { text-decoration: underline; }
  .hero__title { display: flex; flex-direction: column; gap: 24px; max-width: 1100px; }

  .meta-wrap { padding-bottom: 64px; }
  .meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .meta__item { display: flex; flex-direction: column; gap: 8px; }
  .meta__value { font-size: 17px; font-weight: 500; line-height: 1.45; }

  .impact { background: var(--surface); padding: 64px 0; }
  .impact__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .stat { display: flex; flex-direction: column; gap: 8px; font-size: 16px; }
  .stat__value { font-size: clamp(40px, 4.4vw, 56px); font-weight: 500; letter-spacing: -0.035em; line-height: 1.04; }

  .body-wrap { padding: 120px 0; }
  .case { display: grid; grid-template-columns: 3fr 8fr; gap: 144px; align-items: start; }
  .case__nav { position: sticky; top: 120px; display: flex; flex-direction: column; gap: 14px; font-size: 16px; color: var(--muted); }
  .case__nav a:hover, .case__nav a.is-active { color: var(--ink); font-weight: 500; }
  .case__content { display: flex; flex-direction: column; gap: 120px; min-width: 0; }

  .block { display: flex; flex-direction: column; gap: 32px; scroll-margin-top: 120px; }
  .text { display: flex; flex-direction: column; gap: 16px; }
  .bullets { display: flex; flex-direction: column; gap: 8px; }
  .bullets li { position: relative; padding-left: 20px; }
  .bullets li::before { content: '•'; position: absolute; left: 4px; }
  .stack-40 { display: flex; flex-direction: column; gap: 40px; }
  .stack-16 { display: flex; flex-direction: column; gap: 16px; margin: 0; }
  .stack-12 { display: flex; flex-direction: column; gap: 12px; }
  .caption { font-size: 15px; }
  .sub { font-size: 22px; letter-spacing: -0.01em; }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .step { display: flex; flex-direction: column; gap: 12px; background: var(--surface); border-radius: 16px; padding: 20px; font-size: 15px; }
  .step__title { font-size: 20px; letter-spacing: -0.01em; }

  .jtbd { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; padding: 40px; }
  .jtbd__cards { display: flex; flex-direction: column; gap: 12px; }
  .jtbd__card { background: var(--surface); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 12px; font-size: 16px; }
  .jtbd__arrow { font-size: 20px; padding-left: 4px; }
  .jtbd__phone { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .jtbd__phone img { width: 192px; }

  .decisions { display: flex; flex-direction: column; gap: 80px; }
  .decision { display: flex; flex-direction: column; gap: 32px; }
  .decision__text { display: flex; flex-direction: column; gap: 16px; }
  .decision__heading { display: flex; flex-direction: column; gap: 8px; }

  .gallery { display: flex; flex-direction: column; gap: 32px; }
  .gallery__row { display: grid; gap: 32px; }
  .gallery__row--2 { grid-template-columns: 1fr 1fr; }
  .gallery__row--3 { grid-template-columns: 1fr 1fr 1fr; }

  @media (max-width: 1100px) {
    .case { grid-template-columns: 1fr; gap: 0; }
    .case__nav { display: none; }
  }
  @media (max-width: 800px) {
    .hero { padding: 40px 0; }
    .hero__inner { gap: 32px; }
    .meta, .impact__grid { grid-template-columns: 1fr 1fr; gap: 24px 20px; }
    .impact { padding: 48px 0; }
    .body-wrap { padding: 80px 0; }
    .case__content { gap: 80px; }
    .steps { grid-template-columns: 1fr 1fr; }
    .jtbd { grid-template-columns: 1fr; padding: 20px; }
    .gallery, .gallery__row { gap: 16px; }
    .gallery__row--3 { grid-template-columns: 1fr 1fr 1fr; }
    .decisions { gap: 64px; }
  }
  @media (max-width: 480px) {
    .steps { grid-template-columns: 1fr; }
    .gallery__row--2 { grid-template-columns: 1fr; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { nb } from '../lib/nb.js';
import { site } from '../lib/site.js';
import Company from '../components/Company.astro';

const cases = [
  {
    href: '/work/crypto-points/',
    image: '/images/home/cp.webp',
    alt: 'Crypto Points app screens',
    name: 'Crypto Points',
    meta: 'Mobile app · Loyalty · Fintech · 2026',
    title: 'Designed a loyalty program that gives crypto traders a reason to come back',
    theme: 'cp'
  },
  {
    href: '/work/bookdirect/',
    image: '/images/home/bd.webp',
    alt: 'BookDirect.com home page',
    name: 'BookDirect.com',
    meta: 'Web platform · Travel · 2024–2025',
    title: 'Built a direct booking platform from zero to launch in 6 months',
    theme: 'bd'
  },
  {
    href: '/work/el-time/',
    image: '/images/home/et.webp',
    alt: 'El Time rule builder',
    name: 'El Time',
    meta: 'B2B SaaS · Task management · 2023–2024',
    title: 'Made task automation simple enough for any team',
    theme: 'et'
  }
];

const experience = [
  ['Product Designer', 'Paybis', '2025–2026'],
  ['Product Designer, design lead', 'BookDirect.com', '2024–2025'],
  ['UI/UX Designer', 'CompatibL', '2022–2024'],
  ['Product Designer', 'Plasma Finance', '2022']
];
---
<Base title="Julia Kryshyna — Product Designer" current="work">
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <div class="hero__title">
          <h1 class="h1">{nb('I design fintech and booking products — from zero to launch.')}</h1>
          <p class="lead">{nb('7 years designing web and mobile products in fintech, crypto and travel. I build design systems, work closely with developers and use data to make decisions.')}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>Let’s talk</a>
          <a class="btn btn--secondary" href={site.cv} target="_blank" rel="noopener">Download CV</a>
          <a class="hero__more" href="#work">My work ↓</a>
        </div>
      </div>
      <figure class="hero__card">
        <div class="hero__photo">
          <img src="/images/portrait.jpg" alt="Julia Kryshyna" width="416" height="480" />
        </div>
        <figcaption>
          <span class="hero__name">{site.name}</span>
          <span class="muted">Product Designer · {site.city}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="work" id="work">
    <div class="container">
      <h2 class="h2 work__title">Selected work</h2>
      <div class="banners">
        {cases.map((c) => (
          <a class={`banner banner--${c.theme}`} href={c.href}>
            <div class="banner__text">
              <div class="banner__top">
                <span class="banner__name">{c.name}</span>
                <span class="banner__meta">{c.meta}</span>
              </div>
              <h3 class="banner__title">{nb(c.title)}</h3>
              <span class="banner__btn">View case →</span>
            </div>
            <img class="banner__img" src={c.image} alt={c.alt} loading="lazy" width="2624" height="1040" />
          </a>
        ))}
      </div>
      <p class="work__more"><span class="muted">Earlier concepts:</span> <a class="link" href={site.behance} target="_blank" rel="noopener">Smash wallet · Management tool · Dripme on Behance ↗</a></p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="exp__head">
        <div class="exp__heading">
          <p class="label label--accent">Latest · 2022–2026</p>
          <h2 class="h2">Experience</h2>
        </div>
        <p class="muted exp__summary">{nb('7 years in product design: fintech, crypto, travel and B2B SaaS.')}</p>
      </div>
      <ul class="exp__list">
        {experience.map(([role, company, years]) => (
          <li class="exp__row">
            <span class="exp__role"><strong>{role}</strong> <span class="muted"><Company name={company} /></span></span>
            <span class="muted exp__years">{years}</span>
          </li>
        ))}
      </ul>
      <div class="btn-row">
        <a class="btn btn--secondary" href="/about/#experience">Full experience</a>
        <a class="btn btn--primary" href={site.cv} target="_blank" rel="noopener">Download CV</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <div class="about__photo"><img src="/images/portrait-2.jpg" alt="" width="528" height="600" loading="lazy" /></div>
      <div class="about__text">
        <h2 class="h2">Hi, I’m Julia</h2>
        <div class="about__body">
          <p class="body">{nb('I’m a product designer from Warsaw. I like projects that start from zero: research, scope, design system, and then shipping together with developers.')}</p>
          <p class="body muted">{nb('I also taught a year-long UX/UI course to 140 students.')}</p>
        </div>
        <a class="link" href="/about/">More about me →</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const cards = [...document.querySelectorAll('.banner')];
  const motion = matchMedia('(min-width: 801px) and (prefers-reduced-motion: no-preference)');
  let ticking = false;
  const update = () => {
    ticking = false;
    cards.forEach((c, i) => {
      const next = cards[i + 1];
      if (!next || !motion.matches) { c.style.transform = ''; c.style.setProperty('--dim', '0'); return; }
      const gap = next.getBoundingClientRect().top - c.getBoundingClientRect().top;
      const p = Math.min(Math.max(1 - gap / c.offsetHeight, 0), 1);
      c.style.transform = p ? `scale(${1 - p * 0.06})` : '';
      c.style.setProperty('--dim', (p * 0.35).toFixed(3));
    });
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  motion.addEventListener('change', update);
  update();
</script>

<style>
  .hero { padding: 120px 0 96px; }
  .hero__grid { display: grid; grid-template-columns: 7fr 4fr; gap: 144px; align-items: end; }
  .hero__text { display: flex; flex-direction: column; gap: 40px; }
  .hero__title { display: flex; flex-direction: column; gap: 24px; }
  .hero__more { font-size: 16px; font-weight: 500; padding: 0 8px; }
  .hero__card { margin: 0; display: flex; flex-direction: column; gap: 20px; }
  .hero__photo { aspect-ratio: 416 / 480; border-radius: 16px; background: var(--panel); overflow: hidden; }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; }
  .hero__card figcaption { display: flex; flex-direction: column; gap: 4px; font-size: 15px; }
  .hero__name { font-size: 20px; font-weight: 500; }

  .work { padding: 120px 0; }
  .work__title { margin-bottom: 56px; }
  .banners { display: flex; flex-direction: column; gap: 32px; }
  .banner { position: relative; display: block; height: 520px; border-radius: 32px; overflow: hidden; transform-origin: 50% 0; color: var(--b-fg); background: var(--b-bg); }
  .banner::after { content: ''; position: absolute; inset: 0; background: #000; opacity: var(--dim, 0); pointer-events: none; z-index: 2; }
  .banner__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right center; transition: transform .6s ease; }
  .banner:hover .banner__img { transform: scale(1.012); }
  .banner__text { position: relative; z-index: 1; width: 46%; height: 100%; padding: 56px; display: flex; flex-direction: column; justify-content: center; gap: 28px; }
  .banner__top { display: flex; flex-direction: column; gap: 6px; }
  .banner__name { font-size: 18px; font-weight: 600; letter-spacing: -.01em; }
  .banner__meta { font: 500 13px/1.4 ui-monospace, 'SF Mono', Menlo, monospace; text-transform: uppercase; letter-spacing: .03em; color: var(--b-sub); }
  .banner__title { font-size: clamp(28px, 2.7vw, 38px); line-height: 1.12; letter-spacing: -.025em; font-weight: 500; }
  .banner__btn { align-self: flex-start; padding: 14px 22px; border-radius: 999px; font-size: 16px; font-weight: 500; background: var(--b-btn); color: var(--b-btn-fg); transition: transform .2s ease; }
  .banner:hover .banner__btn { transform: translateX(4px); }
  .banner:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .banner--cp { --b-bg: linear-gradient(135deg,#161616,#24331a); --b-fg: #fff; --b-sub: rgba(255,255,255,.7); --b-btn: #d7f25a; --b-btn-fg: #161616; }
  .banner--bd { --b-bg: linear-gradient(135deg,#0b2a66,#1458c4); --b-fg: #fff; --b-sub: rgba(255,255,255,.72); --b-btn: #fff; --b-btn-fg: #0b2a66; }
  .banner--et { --b-bg: linear-gradient(135deg,#efeaff,#dcd3ff); --b-fg: #1d1a33; --b-sub: rgba(29,26,51,.68); --b-btn: #1d1a33; --b-btn-fg: #fff; }
  .banner--papaya { --b-bg: linear-gradient(135deg,#ff9a5a,#fd7a2f); --b-fg: #1d1d27; --b-sub: rgba(29,29,39,.72); --b-btn: #1d1d27; --b-btn-fg: #fff; }
  @media (min-width: 801px) and (max-width: 1180px) {
    .banner__img { left: auto; width: 58%; object-position: 80% center; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%); mask-image: linear-gradient(90deg, transparent, #000 12%); }
    .banner__text { width: 46%; padding: 40px; }
  }
  @media (min-width: 801px) and (prefers-reduced-motion: no-preference) {
    .banners { padding-bottom: 24px; }
    .banner { position: sticky; top: 112px; box-shadow: 0 -12px 40px rgba(0,0,0,.08); }
  }
  .work__more { margin-top: 56px; font-size: 16px; }

  .exp__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 40px; }
  .exp__heading { display: flex; flex-direction: column; gap: 8px; }
  .exp__summary { font-size: 18px; max-width: 420px; }
  .exp__list { margin-bottom: 40px; }
  .exp__row { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 24px 0; border-top: 1px solid var(--line); font-size: 22px; letter-spacing: -0.01em; }
  .exp__row strong { font-weight: 500; }
  .exp__years { font-size: 18px; white-space: nowrap; }

  .about { display: grid; grid-template-columns: 5fr 6fr; gap: 144px; align-items: center; }
  .about__photo { aspect-ratio: 528 / 600; border-radius: 16px; background: var(--panel); overflow: hidden; }
  .about__photo img { width: 100%; height: 100%; object-fit: cover; }
  .about__text { display: flex; flex-direction: column; gap: 32px; align-items: flex-start; }
  .about__body { display: flex; flex-direction: column; gap: 16px; }

  @media (max-width: 1024px) {
    .hero__grid, .about { gap: 64px; }
  }
  @media (max-width: 800px) {
    .hero { padding: 64px 0 64px; }
    .hero__grid, .about { grid-template-columns: 1fr; gap: 48px; }
    .hero__card { max-width: 360px; }
    .work { padding: 80px 0; }
    .work__title { margin-bottom: 32px; }
    .banners { gap: 20px; }
    .banner { height: auto; display: flex; flex-direction: column; border-radius: 24px; }
    .banner__text { width: 100%; height: auto; padding: 28px 24px 8px; gap: 20px; }
    .banner__img { position: static; height: 260px; object-position: 88% center; -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%); mask-image: linear-gradient(180deg, transparent, #000 30%); }
    .exp__row { flex-direction: column; align-items: flex-start; gap: 4px; font-size: 18px; padding: 20px 0; }
    .exp__years { font-size: 15px; }
    .about__photo { max-width: 420px; }
  }
</style>
